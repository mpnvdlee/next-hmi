{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],

    /* Path aliases */
    "paths": {
      "@hmi/*": ["./src/hmi/*"],
      "@config/*": ["./src/config/*"],
      "@shared/*": ["./src/shared/*"],
      "@enterprise": ["./src/enterprise/registry.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* `src`, plus the two helpers beside the stdlib widgets that import app
   * modules and nothing else — they are app code that happens to live under
   * widgets/. The widget *sources* cannot join them: they are written against
   * the ambient SDK globals in custom-widgets-sdk.d.ts, whose `React` and `JSX`
   * declarations shadow @types/react's for every file in the same program. That
   * is what tsconfig.stdlib.json is for; see the note on its `include`. */
  "include": ["src", "widgets/testSdk.ts", "widgets/widgetModuleLoader.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
