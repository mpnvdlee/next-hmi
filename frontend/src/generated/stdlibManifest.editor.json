  "Content/TrendChart": {
    "description": "Plots recorded tag history over selectable time ranges, or buffers live values with no historian.",
    "icon": {
      "type": "builtin",
      "name": "chart-line"
    },
    "schema": {
      "source": {
        "format": "select",
        "label": "Data source",
        "group": "Data",
        "description": "Recorded queries the historian for stored samples. Live buffers values as they arrive over the connection — no historian needed — and starts empty on every page entry.",
        "defaultValue": "history",
        "options": [
          {
            "value": "history",
            "label": "Recorded history"
          },
          {
            "value": "live",
            "label": "Live buffer"
          }
        ]
      },
      "variables": {
        "label": "Variables",
        "group": "Data",
        "description": "Comma-separated variable paths, e.g. testserver:Motor1/Speed, testserver:Motor1/Temperature."
      },
      "timeRange": {
        "format": "select",
        "label": "Default time range",
        "group": "Data",
        "defaultValue": "1h",
        "visibleWhen": {
          "property": "source",
          "notEquals": "live"
        },
        "options": [
          {
            "value": "1m",
            "label": "1 min"
          },
          {
            "value": "5m",
            "label": "5 min"
          },
          {
            "value": "15m",
            "label": "15 min"
          },
          {
            "value": "30m",
            "label": "30 min"
          },
          {
            "value": "1h",
            "label": "1 hour"
          },
          {
            "value": "8h",
            "label": "8 hours"
          },
          {
            "value": "24h",
            "label": "24 hours"
          },
          {
            "value": "7d",
            "label": "7 days"
          },
          {
            "value": "30d",
            "label": "30 days"
          }
        ]
      },
      "refreshInterval": {
        "label": "Refresh interval (s)",
        "group": "Data",
        "description": "How often the chart re-queries history. 0 disables polling.",
        "defaultValue": 10,
        "min": 0,
        "max": 3600,
        "step": 1,
        "visibleWhen": {
          "property": "source",
          "notEquals": "live"
        }
      },
      "liveWindow": {
        "label": "Live window (s)",
        "group": "Data",
        "description": "How much recent history the buffer keeps. 0 keeps whatever fits the sample cap.",
        "defaultValue": 300,
        "min": 0,
        "max": 86400,
        "step": 10,
        "visibleWhen": {
          "property": "source",
          "equals": "live"
        }
      },
      "liveMaxSamples": {
        "label": "Max samples per variable",
        "group": "Data",
        "description": "Hard cap on buffered points. The oldest are dropped first.",
        "defaultValue": 300,
        "min": 10,
        "max": 5000,
        "step": 10,
        "visibleWhen": {
          "property": "source",
          "equals": "live"
        }
      },
      "showControls": {
        "format": "show",
        "label": "Show zoom buttons",
        "group": "Appearance",
        "defaultValue": false,
        "visibleWhen": {
          "property": "source",
          "notEquals": "live"
        }
      },
      "seriesColors": {
        "label": "Line colors",
        "group": "Appearance",
        "description": "Comma-separated colours, one per series. Left empty, the theme series palette is used."
      }
    }
  },
