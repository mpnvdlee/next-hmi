{
  "id": "wiz-2",
  "title": {
    "$loc": "Choose your beans"
  },
  "description": "Gated: Next stays shut until a bean is picked.",
  "showHeader": false,
  "mainBackground": "var(--hmi-bg)",
  "sections": {
    "content": [
      {
        "id": "wiz-2-root",
        "type": "Container",
        "name": "Wizard step",
        "properties": {
          "showWhenEmpty": true,
          "background": "transparent"
        },
        "layout": {
          "direction": "column",
          "gap": "16px",
          "wrap": false,
          "align": "stretch",
          "justify": "flex-start",
          "widthMode": "fill",
          "heightMode": "fixed",
          "paddingTop": "16px",
          "paddingRight": "16px",
          "paddingBottom": "16px",
          "paddingLeft": "16px",
          "height": "430px"
        },
        "children": [
          {
            "id": "wiz-2-card",
            "type": "$component:card",
            "name": "Choose your beans",
            "properties": {
              "title": {
                "$loc": "Choose your beans"
              },
              "showTitle": false
            },
            "layout": {
              "widthMode": "fill",
              "heightMode": "hug",
              "minWidth": "0"
            },
            "children": [
              {
                "id": "wiz-2-card-body",
                "type": "Container",
                "name": "Body",
                "properties": {
                  "showWhenEmpty": true,
                  "background": "transparent"
                },
                "layout": {
                  "direction": "column",
                  "gap": "12px",
                  "wrap": false,
                  "align": "stretch",
                  "justify": "flex-start",
                  "widthMode": "fill",
                  "heightMode": "hug",
                  "paddingTop": "14px",
                  "paddingRight": "18px",
                  "paddingBottom": "18px",
                  "paddingLeft": "18px"
                },
                "children": [
                  {
                    "id": "wiz-2-intro",
                    "type": "Label",
                    "name": "Intro",
                    "properties": {
                      "text": {
                        "$loc": "Pick the beans for this brew."
                      },
                      "typography": "body"
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "hug"
                    }
                  },
                  {
                    "id": "wiz-2-beans",
                    "type": "ButtonRow",
                    "name": "Bean type",
                    "properties": {
                      "label": {
                        "$loc": "Beans"
                      },
                      "options": [
                        {
                          "label": "Espresso",
                          "value": "espresso"
                        },
                        {
                          "label": "Filter",
                          "value": "filter"
                        },
                        {
                          "label": "Decaf",
                          "value": "decaf"
                        }
                      ],
                      "variable": {
                        "$var": {
                          "path": "Brew:Wizard/BeanType"
                        }
                      }
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "hug"
                    }
                  },
                  {
                    "id": "wiz-2-hint",
                    "type": "Label",
                    "name": "Hint",
                    "properties": {
                      "text": {
                        "$loc": "Pick your beans to continue."
                      },
                      "typography": "caption",
                      "color": "var(--hmi-warn)",
                      "visible": {
                        "$compare": {
                          "left": {
                            "$var": {
                              "path": "Brew:Wizard/BeanType"
                            }
                          },
                          "operator": "===",
                          "right": ""
                        }
                      }
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "hug"
                    }
                  }
                ],
                "slot": "body"
              }
            ]
          },
          {
            "id": "wiz-2-push",
            "type": "StretchSpacer",
            "name": "Push",
            "properties": {
              "mode": "ratio",
              "ratio": 1
            },
            "layout": {
              "grow": 1,
              "widthMode": "fill",
              "heightMode": "fill"
            }
          }
        ]
      }
    ]
  }
}