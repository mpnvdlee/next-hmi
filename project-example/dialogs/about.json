                    "$loc": "Brew now confirms with an alert, then writes a variable and reports back with a toast."
                  },
                  "wrap": "wrap",
                  "color": "var(--hmi-text-muted)"
                },
                "layout": {
                  "widthMode": "fill",
                  "heightMode": "hug"
                }
              }
            ]
          },
