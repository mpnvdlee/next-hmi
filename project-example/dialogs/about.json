            "id": "about-r",
            "type": "Container",
            "name": "Recipes",
            "properties": {
              "visible": true,
              "showWhenEmpty": true,
              "background": "transparent"
            },
            "layout": {
              "direction": "column",
              "gap": "2px",
              "wrap": false,
              "align": "stretch",
              "justify": "flex-start",
              "radius": "0",
              "widthMode": "fill",
              "heightMode": "hug",
              "paddingTop": "0",
              "paddingRight": "0",
              "paddingBottom": "0",
              "paddingLeft": "0"
