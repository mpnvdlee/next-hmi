{
  "id": "wiz-3",
  "title": {
    "$loc": "Check your levels"
  },
  "description": "Read-only check of water and beans.",
  "showHeader": false,
  "mainBackground": "var(--hmi-bg)",
  "sections": {
    "content": [
      {
        "id": "wiz-3-root",
        "type": "Container",
        "name": "Wizard step",
        "properties": {
          "showWhenEmpty": true,
          "background": "transparent"
        },
        "layout": {
          "direction": "column",
          "gap": "16px",
          "wrap": false,
          "align": "stretch",
          "justify": "flex-start",
          "widthMode": "fill",
          "heightMode": "fixed",
          "paddingTop": "16px",
          "paddingRight": "16px",
          "paddingBottom": "16px",
          "paddingLeft": "16px",
          "height": "430px"
        },
        "children": [
          {
            "id": "wiz-3-card",
            "type": "$component:card",
            "name": "Check your levels",
            "properties": {
              "title": {
                "$loc": "Check your levels"
              },
              "showTitle": false
            },
            "layout": {
              "widthMode": "fill",
              "heightMode": "hug",
              "minWidth": "0"
            },
            "children": [
              {
                "id": "wiz-3-card-body",
                "type": "Container",
                "name": "Body",
                "properties": {
                  "showWhenEmpty": true,
                  "background": "transparent"
                },
                "layout": {
                  "direction": "column",
                  "gap": "12px",
                  "wrap": false,
                  "align": "stretch",
                  "justify": "flex-start",
                  "widthMode": "fill",
                  "heightMode": "hug",
                  "paddingTop": "14px",
                  "paddingRight": "18px",
                  "paddingBottom": "18px",
                  "paddingLeft": "18px"
                },
                "children": [
                  {
                    "id": "wiz-3-row",
                    "type": "Container",
                    "name": "Levels",
                    "properties": {
                      "showWhenEmpty": true,
                      "background": "transparent"
                    },
                    "layout": {
                      "direction": "row",
                      "gap": "16px",
                      "wrap": true,
                      "align": "center",
                      "justify": "flex-start",
                      "widthMode": "fill",
                      "heightMode": "hug"
                    },
                    "children": [
                      {
                        "id": "wiz-3-ring",
                        "type": "RingGauge",
                        "name": "Water tank",
                        "properties": {
                          "value": {
                            "$var": {
                              "path": "Brew:Tank/WaterLevel"
                            }
                          },
                          "min": 0,
                          "max": 100,
                          "unit": "%",
                          "caption": {
                            "$loc": "Water tank"
                          },
                          "decimals": 0,
                          "size": 124,
                          "thickness": 16,
                          "color": {
                            "$if": {
                              "condition": {
                                "$compare": {
                                  "left": {
                                    "$var": {
                                      "path": "Brew:Tank/WaterLevel"
                                    }
                                  },
                                  "operator": "<",
                                  "right": 15
                                }
                              },
                              "true": "var(--hmi-warn)",
                              "false": "var(--hmi-accent)"
                            }
                          }
                        },
                        "layout": {
                          "widthMode": "hug",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "wiz-3-rows",
                        "type": "Container",
                        "name": "Readings",
                        "properties": {
                          "showWhenEmpty": true,
                          "background": "transparent"
                        },
                        "layout": {
                          "direction": "column",
                          "gap": "10px",
                          "wrap": false,
                          "align": "stretch",
                          "justify": "flex-start",
                          "widthMode": "fill",
                          "heightMode": "hug",
                          "grow": 1,
                          "minWidth": "0"
                        },
                        "children": [
                          {
                            "id": "wiz-3-mr-beans",
                            "type": "$component:metric-row",
                            "name": "Bean level",
                            "properties": {
                              "label": {
                                "$loc": "Bean level"
                              },
                              "text": {
                                "$stringExpr": {
                                  "template": "{Round(1)} %",
                                  "wildcards": {
                                    "1": {
                                      "$var": {
                                        "path": "Brew:Hopper/BeanLevel"
                                      }
                                    }
                                  }
                                }
                              },
                              "value": {
                                "$var": {
                                  "path": "Brew:Hopper/BeanLevel"
                                }
                              },
                              "max": 100,
                              "color": "var(--hmi-accent)"
                            },
                            "layout": {
                              "widthMode": "fill",
                              "heightMode": "hug"
                            }
                          },
                          {
                            "id": "wiz-3-mr-water",
                            "type": "$component:metric-row",
                            "name": "Water tank",
                            "properties": {
                              "label": {
                                "$loc": "Water tank"
                              },
                              "text": {
                                "$stringExpr": {
                                  "template": "{Round(1)} %",
                                  "wildcards": {
                                    "1": {
                                      "$var": {
                                        "path": "Brew:Tank/WaterLevel"
                                      }
                                    }
                                  }
                                }
                              },
                              "value": {
                                "$var": {
                                  "path": "Brew:Tank/WaterLevel"
                                }
                              },
                              "max": 100,
                              "color": "var(--hmi-ok)"
                            },
                            "layout": {
                              "widthMode": "fill",
                              "heightMode": "hug"
                            }
                          },
                          {
                            "id": "wiz-3-note",
                            "type": "Label",
                            "name": "Note",
                            "properties": {
                              "text": {
                                "$loc": "Top either up on the Machine page if it is running low."
                              },
                              "typography": "caption",
                              "color": "var(--hmi-text-muted)"
                            },
                            "layout": {
                              "widthMode": "fill",
                              "heightMode": "hug"
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "slot": "body"
              }
            ]
          },
          {
            "id": "wiz-3-push",
            "type": "StretchSpacer",
            "name": "Push",
            "properties": {
              "mode": "ratio",
              "ratio": 1
            },
            "layout": {
              "grow": 1,
              "widthMode": "fill",
              "heightMode": "fill"
            }
          }
        ]
      }
    ]
  }
}