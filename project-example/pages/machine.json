                          },
                          "step": 1,
                          "min": 0,
                          "max": 999,
                          "decimals": 0,
                          "showRangeOnNumpad": true
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-consumables-rule",
                        "type": "Separator",
                        "name": "Divider",
                        "properties": {
                          "orientation": "horizontal",
                          "thickness": 1,
