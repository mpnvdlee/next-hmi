{
  "id": "machine",
  "title": {
    "$loc": "Machine"
  },
  "icon": "sliders-horizontal",
  "description": "Drive the machine by hand",
  "showHeader": false,
  "mainBackground": "var(--hmi-bg)",
  "sections": {
    "content": [
      {
        "id": "mach-root",
        "type": "Container",
        "name": "Page",
        "properties": {
          "visible": true,
          "showWhenEmpty": true,
          "background": "transparent"
        },
        "layout": {
          "direction": "column",
          "gap": "18px",
          "wrap": false,
          "align": "stretch",
          "justify": "flex-start",
          "radius": "0",
          "width": "100%",
          "widthMode": "fixed",
          "heightMode": "hug",
          "paddingTop": "20px",
          "paddingRight": "20px",
          "paddingBottom": "20px",
          "paddingLeft": "20px"
        },
        "children": [
          {
            "id": "mach-intro",
            "type": "Container",
            "name": "Intro",
            "properties": {
              "visible": true,
              "showWhenEmpty": true,
              "background": "var(--hmi-surface-raised)",
              "border": "1px solid var(--hmi-border)"
            },
            "layout": {
              "direction": "row",
              "gap": "10px",
              "wrap": false,
              "align": "center",
              "justify": "flex-start",
              "radius": "var(--hmi-radius)",
              "widthMode": "fill",
              "heightMode": "hug",
              "paddingTop": "12px",
              "paddingRight": "16px",
              "paddingBottom": "12px",
              "paddingLeft": "16px"
            },
            "children": [
              {
                "id": "mach-intro-i",
                "type": "Icon",
                "name": "Info",
                "properties": {
                  "iconName": {
                    "$static": {
                      "type": "builtin",
                      "name": "info"
                    }
                  },
                  "size": 18,
                  "color": "var(--hmi-accent)"
                },
                "layout": {
                  "widthMode": "hug",
                  "heightMode": "hug"
                }
              },
              {
                "id": "mach-intro-t",
                "type": "Label",
                "name": "mach-intro-t",
                "properties": {
                  "typography": "body",
                  "text": {
                    "$loc": "There is no PLC behind this demo — you are the PLC. Everything here drives the Brew and Monitor pages."
                  },
                  "wrap": "wrap"
                },
                "layout": {
                  "grow": 1,
                  "widthMode": "fill",
                  "heightMode": "hug"
                }
              }
            ]
          },
          {
            "id": "mach-row-1",
            "type": "Container",
            "name": "Row",
            "properties": {
              "visible": true,
              "showWhenEmpty": true,
              "background": "transparent"
            },
            "layout": {
              "direction": "row",
              "gap": "18px",
              "wrap": true,
              "align": "stretch",
              "justify": "flex-start",
              "radius": "0",
              "widthMode": "fill",
              "heightMode": "hug",
              "paddingTop": "0",
              "paddingRight": "0",
              "paddingBottom": "0",
              "paddingLeft": "0"
            },
            "children": [
              {
                "id": "mach-power",
                "type": "$component:card",
                "name": "mach-power",
                "properties": {
                  "title": {
                    "$loc": "Power & grind"
                  },
                  "showTitle": true
                },
                "layout": {
                  "grow": 1,
                  "widthMode": "fill",
                  "heightMode": "hug",
                  "minWidth": "300px"
                },
                "children": [
                  {
                    "id": "mach-power-body",
                    "type": "Container",
                    "name": "Body",
                    "properties": {
                      "visible": true,
                      "showWhenEmpty": true,
                      "background": "transparent"
                    },
                    "layout": {
                      "direction": "column",
                      "gap": "14px",
                      "wrap": false,
                      "align": "stretch",
                      "justify": "flex-start",
                      "radius": "0",
                      "widthMode": "fill",
                      "heightMode": "hug",
                      "paddingTop": "8px",
                      "paddingRight": "18px",
                      "paddingBottom": "18px",
                      "paddingLeft": "18px"
                    },
                    "children": [
                      {
                        "id": "mach-sw-power",
                        "type": "Switch",
                        "name": "Main power",
                        "properties": {
                          "label": {
                            "$loc": "Main power"
                          },
                          "labelPosition": "left",
                          "variable": {
                            "$var": {
                              "path": "Brew:Machine/Power"
                            }
                          },
                          "color": "var(--hmi-accent)"
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-sw-brewing",
                        "type": "Switch",
                        "name": "Brewing",
                        "properties": {
                          "label": {
                            "$loc": "Brewing"
                          },
                          "labelPosition": "left",
                          "variable": {
                            "$var": {
                              "path": "Brew:Machine/Brewing"
                            }
                          },
                          "color": "var(--hmi-accent)"
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-power-rule",
                        "type": "Separator",
                        "name": "Divider",
                        "properties": {
                          "orientation": "horizontal",
                          "thickness": 1,
                          "color": "var(--hmi-border)",
                          "inset": 0
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-grind",
                        "type": "ButtonRow",
                        "name": "Grind",
                        "properties": {
                          "label": {
                            "$loc": "Grind"
                          },
                          "options": [
                            {
                              "label": "Fine",
                              "value": "fine"
                            },
                            {
                              "label": "Medium",
                              "value": "medium"
                            },
                            {
                              "label": "Coarse",
                              "value": "coarse"
                            }
                          ],
                          "variable": {
                            "$var": {
                              "path": "Brew:Hopper/Grind"
                            }
                          }
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      }
                    ],
                    "slot": "body"
                  }
                ]
              },
              {
                "id": "mach-setpoints",
                "type": "$component:card",
                "name": "mach-setpoints",
                "properties": {
                  "title": {
                    "$loc": "Setpoints"
                  },
                  "showTitle": true
                },
                "layout": {
                  "grow": 1,
                  "widthMode": "fill",
                  "heightMode": "hug",
                  "minWidth": "300px"
                },
                "children": [
                  {
                    "id": "mach-setpoints-note",
                    "type": "Label",
                    "name": "mach-setpoints-note",
                    "properties": {
                      "typography": "code",
                      "text": {
                        "$loc": "drives the Brew page"
                      },
                      "color": "var(--hmi-text-muted)"
                    },
                    "layout": {
                      "widthMode": "hug",
                      "heightMode": "hug"
                    },
                    "slot": "action"
                  },
                  {
                    "id": "mach-setpoints-body",
                    "type": "Container",
                    "name": "Body",
                    "properties": {
                      "visible": true,
                      "showWhenEmpty": true,
                      "background": "transparent"
                    },
                    "layout": {
                      "direction": "column",
                      "gap": "14px",
                      "wrap": false,
                      "align": "stretch",
                      "justify": "flex-start",
                      "radius": "0",
                      "widthMode": "fill",
                      "heightMode": "hug",
                      "paddingTop": "8px",
                      "paddingRight": "18px",
                      "paddingBottom": "18px",
                      "paddingLeft": "18px"
                    },
                    "children": [
                      {
                        "id": "mach-st-setpoint",
                        "type": "NumericStepper",
                        "name": "Boiler setpoint",
                        "properties": {
                          "label": {
                            "$loc": "Boiler setpoint"
                          },
                          "unit": "°C",
                          "variable": {
                            "$var": {
                              "path": "Brew:Boiler/Setpoint"
                            }
                          },
                          "step": 0.5,
                          "min": 80,
                          "max": 100,
                          "decimals": 1,
                          "showRangeOnNumpad": true
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-st-temp",
                        "type": "NumericStepper",
                        "name": "Boiler temperature",
                        "properties": {
                          "label": {
                            "$loc": "Boiler temperature"
                          },
                          "unit": "°C",
                          "variable": {
                            "$var": {
                              "path": "Brew:Boiler/Temp"
                            }
                          },
                          "step": 1,
                          "min": 0,
                          "max": 120,
                          "decimals": 1,
                          "showRangeOnNumpad": true
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-st-press",
                        "type": "NumericStepper",
                        "name": "Pump pressure",
                        "properties": {
                          "label": {
                            "$loc": "Pump pressure"
                          },
                          "unit": "bar",
                          "variable": {
                            "$var": {
                              "path": "Brew:Pump/Pressure"
                            }
                          },
                          "step": 0.1,
                          "min": 0,
                          "max": 12,
                          "decimals": 1,
                          "showRangeOnNumpad": true
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      },
                      {
                        "id": "mach-st-dose",
                        "type": "NumericStepper",
                        "name": "Dose",
                        "properties": {
                          "label": {
                            "$loc": "Dose"
                          },
                          "unit": "g",
                          "variable": {
                            "$var": {
                              "path": "Brew:Hopper/Dose"
                            }
                          },
                          "step": 0.5,
                          "min": 14,
                          "max": 22,
                          "decimals": 1,
                          "showRangeOnNumpad": true
                        },
                        "layout": {
                          "widthMode": "fill",
                          "heightMode": "hug"
                        }
                      }
                    ],
                    "slot": "body"
                  }
                ]
              }
            ]
          },
          {
