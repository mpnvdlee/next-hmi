# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/*
!build/docker-entrypoint.sh
!build/nexthmi.spec
!build/build-binary.sh
