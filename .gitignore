!build/lgpl-OFFER.txt
!build/lgpl/
!build/lgpl/*
*.egg
.eggs/

# Virtual environment
backend/.venv/
.venv/
venv/
env/

# ── Node / Frontend ───────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Stdlib widget build output. Both are regenerated by `npm run build:stdlib`
# (which `dev` and `build` both run first). The baked manifest it also emits —
# frontend/src/generated/stdlibManifest.json and its .editor.json half — IS
# tracked: tsc imports both, and a drift test pins them to the sources the way
# docs/user/catalog.md is pinned.
frontend/.stdlib-build/
frontend/public/stdlib-js/

# Backend static output (built frontend)
backend/static/

# ── Dev/test project ─────────────────────────────────────────
# project-testbench/ lives in the private enterprise repo and is cloned in
# here for dev (same pattern as enterprise/). Root-anchored so it never
# matches a same-named path elsewhere. Public builds seed from project-seed/.
/project-testbench/

# Runtime logs — never commit
.dev-logs/

# ── IDE / Editor ──────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Secrets / env files ───────────────────────────────────────
.env
.env.local
.env.*.local

# ── Test artefacts ────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
frontend/coverage/
.ruff_cache/

# ── Claude harness runtime state ─────────────────────────────
.claude/scheduled_tasks.lock
.claude/worktrees/

# ── Custom widget build artefacts ────────────────────────────
backend/widget-build/
project-seed/.widget-build/

# ── Dev runtime home ─────────────────────────────────────────
.dev-runtime-home/

# ── Plugin runtime data (per-project, generated at runtime) ─
project-testbench/plugins/**/*.db
project-testbench/plugins/**/*.db-shm
project-testbench/plugins/**/*.db-wal
project-testbench/plugins/**/config.json

# ── Historian runtime data (per-project, generated at runtime) ─
project-testbench/historian/history.db*

# ── Claude harness runtime state ─────────────────────────────
.claude/

# ── Baseline-migration backups (core/project_migrations.py) — never commit ──
*.pre-migration-backup-*/

# ── Enterprise edition (own repo, own licence — never in the public tree) ──
# Root-anchored on purpose: an unanchored "enterprise" also matches
# frontend/src/enterprise/, which is the *public* AGPL stub and must be tracked.
# No trailing slash: git's trailing-slash gitignore matching only matches
# directories, not a symlink named "enterprise" (D6 peer checkout) — with the
# slash the symlink itself would show up untracked in `git status`.
/enterprise

# ── Auto-generated OPC-UA client certificates — never commit private keys ──
# Generated on first secured connect by opcua/client_pool.py; the seed
# certs/ dir keeps only its .gitkeep.
project-testbench/certs/*.pem
